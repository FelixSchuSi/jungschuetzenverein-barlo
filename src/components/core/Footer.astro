---
import { Icon } from 'astro-icon/components';
import Container from '../core/Container.astro';
import { BASE_PATH_WITHOUT_DOMAIN } from '../../../base-path.mjs';
import type {
	footerLists as FooterLists,
	footerSocials as FooterSocials,
} from '../../config/footer';

interface Props {
	footerSocials: typeof FooterSocials;
	footerLists: typeof FooterLists;
	copyrightName: string;
	background: string;
	color: string;
}

const sponsoren: {
	src: string;
	link: string;
}[] = [
	{
		src: '/assets/sponsoren/alex-bautrockung.webp',
		link: 'https://www.bautrocknung-alex.de/',
	},
	{
		src: '/assets/sponsoren/sparkasse.webp',
		link: 'https://www.stadtsparkasse-bocholt.de/',
	},
	{
		src: '/assets/sponsoren/autohaus-schuermann.webp',
		link: 'https://kfz-schuermann.de/',
	},
	{
		src: '/assets/sponsoren/blumen-straatman.webp',
		link: 'https://www.blumen-bocholt.de/',
	},
	{
		src: '/assets/sponsoren/hessling.webp',
		link: 'https://hessling-holzbearbeitung.de/',
	},
	{
		src: '/assets/sponsoren/volksbank.webp',
		link: 'https://www.vb-bocholt.de/',
	},
	{
		src: '/assets/sponsoren/kranenburg.webp',
		link: 'https://www.kranenburg.com/',
	},
	{
		src: '/assets/sponsoren/kampshoff.webp',
		link: 'https://nrw-holzhaus.com/',
	},

	{
		src: '/assets/sponsoren/moelders.webp',
		link: 'https://www.moelders-elektro.de/',
	},
	{
		src: '/assets/sponsoren/nightlife-media.webp',
		link: 'https://www.instagram.com/nightlife_media_boh/',
	},
	{
		src: '/assets/sponsoren/wuebling.webp',
		link: 'https://www.instagram.com/wubling_agrar_service/',
	},
	{
		src: '/assets/sponsoren/hagemeyer.webp',
		link: 'https://www.instagram.com/lust_am_fahren_/',
	},
	// { src: '/assets/sponsoren/schluetter.webp', link: 'https://www.schluettergmbh.de/' },
];

const { footerSocials, footerLists, copyrightName, background, color } =
	Astro.props;
---

<footer
	style={background && `--footer-bg:${background}; --footer-color:${color}`}
>
	<Container>
		<div class="footer-grid__container">
			<div class="footer-brand__container">
				<div>
					<slot name="logo" />
				</div>
				<ul class="footer-socials__list">
					{
						footerSocials.map(social => (
							<li class="footer-socials__item">
								<a
									href={social.url}
									target="_blank"
									rel="noopener noreferrer"
									class="footer-socials__link"
									title={`${social.name} öffnen`}
								>
									<Icon name={social.icon} width={24} height={24} />
								</a>
							</li>
						))
					}
				</ul>
			</div>
			{
				footerLists.map(list => (
					<div>
						<p>
							<strong>{list.title}</strong>
						</p>
						<ul class="footer-link__list">
							{list.items.map(item => (
								<li>
									<a href={BASE_PATH_WITHOUT_DOMAIN + item.slug}>
										{item.title}
									</a>
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>

		<div class="footer__sponsors">
			{
				sponsoren.map(({ link, src }) => {
					return (
						<a href={link} target="_blank">
							<img src={src} />
						</a>
					);
				})
			}
		</div>
		<div class="footer-copyright__container">
			<p>Copyright &copy; {new Date().getFullYear()} {copyrightName}</p>
		</div>
	</Container>
</footer>

<style>
	footer {
		--footer-bg: var(--theme-primary);
		--footer-color: var(--theme-on-primary);
		min-height: 40vh;
		background-color: var(--footer-bg);
		color: var(--footer-color);
		border-top-left-radius: var(--theme-shape-radius);
		border-top-right-radius: var(--theme-shape-radius);
	}
	.footer-grid__container {
		padding: 10vh 0 1rem 0;
		display: grid;
		grid-template-columns: 2fr 1fr 1fr 1fr;
	}
	.footer-socials__list {
		margin: 1rem 0;
		padding: 0;
		display: flex;
		list-style: none;
	}
	.footer-socials__item {
		margin-right: 0.5rem;
	}
	.footer-link__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.footer-link__list li {
		margin-bottom: 0.5rem;
	}
	.footer-link__list li a {
		text-decoration: none;
	}
	.footer-link__list li a:hover {
		opacity: 0.84;
	}
	.footer-copyright__container {
		display: flex;
		flex-direction: column;
		/* justify-content: space-between; */
	}
	.footer-copyright__container p {
		font-size: var(--font-size-sm);
	}
	@media (max-width: 768px) {
		.footer-grid__container :first-child {
			grid-column: 1/-1;
		}
		.footer-grid__container {
			padding: 5vh 0;
			grid-template-columns: repeat(2, 1fr);
			gap: 1rem;
		}
	}
	@media (max-width: 600px) {
		.footer-grid__container {
			padding: 5vh 0;
			grid-template-columns: 1fr;
			gap: 1rem;
		}
		.footer-copyright__container {
			flex-direction: column;
		}
	}

	.footer__sponsors {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		padding-bottom: 1rem;
	}

	.footer__sponsors > * {
		width: 150px;
	}
</style>
